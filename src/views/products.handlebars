<div class="container text-center">
    <h2>Bienvenido!</h2>
    <p>Usuario: {{user.first_name}} {{user.last_name}}</p>
    <p>Rol: {{user.role}}</p>
    <button class="btn btn-secondary" id="logout-btn">Logout</button>
</div>
<hr>

{{#if isValid}}
    <h3>Productos</h3>
    <hr>
    <div class="list-group">
        {{#each products}}
            <div class="list-group-item">
                <a href="/products/{{this._id}}">
                    <h5>{{this.title}}</h5>
                </a>
                <div>
                    <p>{{this.description}}</p>
                    <p>Precio: {{this.price}}</p>
                </div>
            </div>
        {{/each}}
    </div>
    <hr>
    <div class="m-3 justify-center">
        {{#if prevPageUrl}}
            <a href="{{prevPageUrl}}" class="btn btn-secondary d-inline p-2">Anterior</a>
        {{/if}}
        
        <p class="d-inline p-2">  {{page}}  </p>
        
        {{#if nextPageUrl}}
            <a href="{{nextPageUrl}}" class="btn btn-secondary d-inline p-2">Siguiente</a>
        {{/if}} 
    </div>
{{else}}
    <h2>No se encuentran productos para mostrar</h2>
{{/if}}

<script src="/js/logout.js"></script>