<h1 class="text-center">Bienvenido</h1>
<hr>
<h3 class="text-center">Inicio de sesión</h3>
<div class="container-md d-flex justify-center" style="max-width: 560px;">
    <form id="login-form" class="col">
        <div class="row m-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" name="email">
        </div>
        <div class="row m-3">
            <label for="password" class="form-label">Password</label>
            <input type="password" name="password">
        </div>
        <div class="row m-3 text-center">
            <button type="submit" class="btn btn-success ">Ingresar</button>
            <p>Aun no eres usuario? <a href="/register">Registrate aquí</a></p>
        </div>
    </form>

</div>
<div class="text-center">
    <p id="error-message" class="error-message" style="display: none; color: red"></p>
    <p class="p-3"><a href="/forgot-password">¿Olvidaste tu contraeña?</a></p>
</div>
<div class="container-md d-flex justify-center" style="max-width: 560px;">
    <a href="/api/session/github">
        <button type="button" class="btn btn-secondary" id="github-btn">
            Inicia sesión con Github
        </button>
    </a>
</div>
<script src="/js/login.js"></script>