<div class="container-fluid">
    <div class="card text-center m-3">
        <div class="card-header">
            <h4>Carrito</h4>
            <p>id: {{cart._id}}</p> 
        </div>
        <div class="card-body">
            {{#if cart.products.length}}
                    {{#each cart.products}}
                    <div class="card m-2" style="max-width: 720px;">
                        <div class="row g-0">
                            <div class="col-md-4">
                                <img src="" class="card-img" alt={{this.product.title}}>
                            </div>
                            <div class="col-md-8">
                                <h5 class="p-2">{{this.product.title}}</h5>
                                <p>Cantidad: {{this.productquantity}}</p>
                                <p>Precio unitario: ${{this.product.price}}</p>
                                <button class="btn btn-danger m-2">Eliminar</button>
                            </div>
                        </div>
                    </div>
                    {{/each}}
            {{else}}
            <h5>Tu carrito está vacío</h5>
            {{/if}}
        </div>
    </div>
</div>
