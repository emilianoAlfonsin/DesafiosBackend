<div class="card text-center">
    <div class="cad-header">
        <h4>Carrito</h4>
        <p>id: {{cart.id}}</p>
    </div>
    <div class="card body">
        {{#if cart.products.length}}
            <ul class="card mb-2">
                {{#each carts.products}}
                    <h5>{{this.product.title}}</h5>
                    <p>Cantidad: {{this.product.quantity}}</p>
                    <p>Precio unitario: {{this.product.price}}</p>
                {{/each}}
            </ul>
        {{else}}
        <h5>Tu carrito está vacío</h5>
        {{/if}}
    </div>
</div>