<h1 class="text-center">Restaura tu contraseña</h1>
<div class="container-md d-flex justify-center" style="max-width: 560px;">
    <form id="restore-form" class="col">
        <div class="row m-3" style="max-width: 320px;">
            <label for="email" class="form-label">Email</label>
            <input type="email" name="email">
        </div>
        <div class="row m-3" style="max-width: 320px;">
            <label for="password" class="form-label">Nueva contraseña</label>
            <input type="password" name="password">
        </div>
        <div class="row m-3" style="max-width: 320px;">
            <button type="submit" class="btn btn-success ">Restaurar</button>
        </div>
    </form>
</div>
    <p class="text-center"><a href="/">Vuelve al inicio</a></p>

<script src="/js/restorePassword.js"></script>