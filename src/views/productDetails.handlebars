<div class="container d-flex align-center">
    <div class="card border-dark m-5" style="max-width: 720px;">
        <img src="/assets/{{this.thumbnail}}" alt="" class="card-img-top" style="max-width: 720px;">
        <div class="card-body m-3">
            <h5 class="m-2">{{this.title}}</h5>
            <p>{{this.description}}</p>
            <p>Precio: ${{this.price}}</p>
            <p>Código: {{this.code}}</p>
            <p>Stock disponible: {{this.stock}}</p>
            <p>Categoría: {{this.category}}</p>
            <button class="btn btn-success">Agregar al carrito</button>
        </div>
    </div>
</div>