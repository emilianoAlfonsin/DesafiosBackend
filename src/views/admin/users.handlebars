<h1>Administrar Usuarios</h1>
    <table>
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            {{#each users}}
                <tr>
                    <td>{{first_name}} {{last_name}}</td>
                    <td>{{email}}</td>
                    <td>{{role}}</td>
                    <td>
                        <form action="/admin/users/{{_id}}/role" method="post">
                            <select name="role">
                                <option value="user" {{#if (eq role "user")}}selected{{/if}}>Usuario</option>
                                <option value="premium" {{#if (eq role "premium")}}selected{{/if}}>Premium</option>
                                <option value="admin" {{#if (eq role "admin")}}selected{{/if}}>Administrador</option>
                            </select>
                            <button type="submit">Modificar Rol</button>
                        </form>
                        <form action="/admin/users/{{_id}}" method="post">
                            <input type="hidden" name="_method" value="delete">
                            <button type="submit">Eliminar</button>
                        </form>
                    </td>
                </tr>
            {{/each}}
        </tbody>
    </table>